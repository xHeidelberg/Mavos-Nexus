# Add / change these in the .env that Laravel generates
APP_TIMEZONE=Asia/Manila          # keep fixed: timestamps are stored in this zone
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mavos_nexus
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file               # API only; avoids needing a sessions table
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log          # change to "reverb" once Laravel Reverb is installed (live dashboard)
SEED_ADMIN_PASSWORD=              # optional; a random temporary one is printed if empty
